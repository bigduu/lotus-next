# syntax=docker/dockerfile:1

FROM rust:1-bookworm AS builder

WORKDIR /app

COPY . .

ENV CARGO_NET_RETRY=5

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    BAMBOO_FRONTEND_BUILD_MODE=api-only cargo build --release --locked --bin bamboo \
    && cp /app/target/release/bamboo /tmp/bamboo

FROM debian:bookworm-slim AS runtime

LABEL org.opencontainers.image.revision="49c6f3b8b4d0f72674f888aa3abcef7cd91cd372"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 python3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home-dir /data --shell /usr/sbin/nologin bamboo \
    && mkdir -p /data \
    && chown bamboo:bamboo /data

COPY --from=builder /tmp/bamboo /usr/local/bin/bamboo
COPY .lotus-real-bamboo-provider.py /usr/local/libexec/lotus-real-bamboo-provider.py

ENV HOME=/data
ENV BAMBOO_DATA_DIR=/data/bamboo
ENV BAMBOO_PORT=9562
ENV BAMBOO_BIND=0.0.0.0

EXPOSE 9562

USER bamboo

ENTRYPOINT ["bamboo"]
CMD ["serve", "--port", "9562", "--bind", "0.0.0.0", "--workers", "1", "--data-dir", "/data/bamboo", "--static-dir", "/frontend"]
