{
  "schema_version": 1,
  "server": {
    "product": "bamboo"
  },
  "api": {
    "name": "bamboo.agent",
    "canonical_base_path": "/api/v1",
    "version": 1
  },
  "realtime": {
    "name": "bamboo.v2",
    "path": "/v2/stream",
    "version": 2,
    "subprotocol": {
      "name": "bamboo.v2",
      "encoding": "json"
    }
  },
  "capabilities": [
    "auth.ws_hello_ack.v1",
    "realtime.account_feed.v1",
    "realtime.agent_events.v1",
    "realtime.application_heartbeat.v1",
    "realtime.feed_cursor.v1",
    "realtime.feed_reset.v1",
    "realtime.stop_control.v1"
  ],
  "auth": {
    "password_enabled": {
      "capability": "auth.password_cookie.v1",
      "verify_path": "/api/v1/bamboo/access/verify"
    },
    "device_auth_enabled": {
      "capability": "auth.device_bearer.v1",
      "pair_path": "/v2/pair"
    }
  }
}
