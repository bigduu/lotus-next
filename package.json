{
  "name": "@bigduu/lotus-next",
  "private": false,
  "version": "0.0.0",
  "description": "Standalone Lotus Next frontend assets for the Bamboo runtime and Bodhi shell.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigduu/lotus-next.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:solid": "vite --config vite.solid.config.ts",
    "build:solid": "tsc -p tsconfig.solid.json && vite build --config vite.solid.config.ts",
    "build:solid:artifact": "tsc -p tsconfig.solid.json && vite build --config vite.solid.config.ts --mode solid-artifact && node scripts/artifact-manifest.mjs generate --dist dist-solid-artifact",
    "verify:solid:artifact": "node scripts/verify-solid-artifact.mjs",
    "type-check": "tsc -b --pretty false",
    "build": "tsc -b && vite build && node scripts/artifact-manifest.mjs generate",
    "lint": "oxlint --deny-warnings",
    "theme:generate": "node --experimental-strip-types scripts/theme-tokens.mjs",
    "theme:check": "node --experimental-strip-types scripts/theme-tokens.mjs --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run build && npm run test:e2e:built",
    "test:e2e:built": "playwright test --config=playwright.feature.config.ts",
    "test:e2e:solid": "npm run build:solid && playwright test --config=playwright.solid.config.ts",
    "test:e2e:real-bamboo": "npm run build && npm run test:e2e:real-bamboo:built",
    "test:e2e:real-bamboo:built": "playwright test --config=playwright.real-bamboo.config.ts",
    "test:e2e:published-bamboo": "node scripts/published-real-bamboo-acceptance.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "artifact:verify": "node scripts/artifact-manifest.mjs verify",
    "package:contents": "node scripts/verify-package.mjs",
    "pack:check": "npm run build && npm run package:contents",
    "verify": "npm run test:run && npm run verify:artifact",
    "verify:artifact": "npm run lint && npm run theme:check && npm run i18n:check && npm run architecture:check && npm run build && npm run package:contents",
    "prepack": "npm run build",
    "preview": "vite preview",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "@dnd-kit/dom": "0.5.0",
    "@kobalte/core": "2.0.0-alpha.5",
    "@lucide/solid": "1.78.0",
    "@msgpack/msgpack": "^3.1.3",
    "@playwright/test": "^1.62.1",
    "@solidjs/vite-plugin": "3.0.1",
    "@solidjs/web": "2.0.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/virtual-core": "3.17.11",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-hard-break": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-mention": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-text": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "@types/hast": "3.0.4",
    "@types/node": "^24.13.2",
    "aria-hidden": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.2",
    "jsdom": "^27.1.0",
    "jspdf": "^4.2.1",
    "linkifyjs": "^4.3.3",
    "mermaid": "^11.16.1",
    "oxlint": "^1.69.0",
    "pako": "2.2.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "2.3.1",
    "remark-cjk-friendly-gfm-strikethrough": "2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remend": "1.3.1",
    "shiki": "3.23.0",
    "solid-js": "2.0.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "unified": "11.0.5",
    "vite": "^8.1.0",
    "vitest": "^4.0.18",
    "zustand": "^5.0.14"
  }
}
