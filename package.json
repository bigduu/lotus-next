{
  "name": "@bigduu/lotus-next",
  "private": false,
  "version": "0.0.0",
  "description": "Standalone Lotus Next frontend assets for the Bamboo runtime and Bodhi shell.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigduu/lotus-next.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "type-check": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "test": "vitest",
    "test:run": "vitest run",
    "pack:check": "npm run build && node scripts/verify-package.mjs",
    "prepack": "npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.21.0",
    "mermaid": "^11.16.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^27.1.0",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.0.18"
  }
